                                else if (password && player.password !== password) {
                                    res.setHeader('Content-Type', 'application/json');
                                    res.end(JSON.stringify({ success: false, error: "Неверный пароль!" }));
                                    return;
                                }
                                if (newScore > player.score) player.score = newScore;
                            } else {
                                scores.push({ name, password: password || "", score: newScore });
                            }
                            scores.sort((a, b) => b.score - a.score);
                            writeScores(scores.slice(0, 100));
                            res.setHeader('Content-Type', 'application/json');
                            res.end(JSON.stringify({ success: true, scores: scores.slice(0, 100).map(s => ({ name: s.name, score: s.score })) }));
                        } catch (e) {
                            res.setHeader('Content-Type', 'application/json');
                            res.end(JSON.stringify({ success: false, error: "Bad request" }));
                        }
                    });
                    return;
                }

                // === RATING API ===
                if (url === '/api/rating' && method === 'GET') {
                    res.setHeader('Content-Type', 'application/json');
                    res.end(JSON.stringify(readRating()));
                    return;
                }
                if (url === '/api/rating/like' && method === 'POST') {
                    const data = readRating();
                    data.likes += 1;
                    writeRating(data);
                    res.setHeader('Content-Type', 'application/json');
                    res.end(JSON.stringify(data));
                    return;
                }
                if (url === '/api/rating/dislike' && method === 'POST') {
                    const data = readRating();
                    data.dislikes += 1;
                    writeRating(data);
                    res.setHeader('Content-Type', 'application/json');
                    res.end(JSON.stringify(data));
                    return;
                }

                // === ONLINE PING API ===
                if (url === '/api/online-ping' && method === 'GET') {
                    const userIp = req.headers['x-forwarded-for'] || req.socket.remoteAddress;
                    const now = Date.now();
                    if (!server._activeUsers) server._activeUsers = new Map();
                    server._activeUsers.set(userIp, now);
                    // Чистим старых (>20 сек)
                    for (const [ip, lastSeen] of server._activeUsers.entries()) {
                        if (now - lastSeen > 20000) server._activeUsers.delete(ip);
                    }
                    res.setHeader('Content-Type', 'application/json');
                    res.end(JSON.stringify({ count: server._activeUsers.size }));
                    return;
                }

                // === AUTH CHECK ===
                if (url === '/api/auth-check' && method === 'POST') {
                    let body = '';
                    req.on('data', chunk => body += chunk);
                    req.on('end', () => {
                        try {
                            const { name, password } = JSON.parse(body);
                            const scores = readScores();
                            const player = scores.find(entry => entry.name && entry.name.toLowerCase() === name.toLowerCase());
                            if (player && player.password !== password) {
