    window.updateOnlineText(currentOnlineCount);

    async function pingOnline() {
        try {
            const response = await fetch('/api/online-ping');
            if (response.ok) {
                const data = await response.json();
                window.updateOnlineText(data.count);
            }
        } catch (e) {
            console.error("Ошибка обновления онлайна:", e);
        }
    }
    pingOnline();
    const onlineInterval = setInterval(pingOnline, 10000);

    const langBtn = document.createElement('button');
    langBtn.className = 'menu-btn-small menu-lang-btn';

    // ===== БЛОК РЕЙТИНГА =====
    const ratingBlock = document.createElement('div');
    ratingBlock.id = 'rating-block';

    const likeBtn = document.createElement('div');
    likeBtn.className = 'rating-btn rating-like';
    likeBtn.id = 'like-btn';
    if (window._isAlreadyRated) likeBtn.classList.add('rated');
    likeBtn.innerHTML = '👍 <span class="rating-count" id="like-count">0</span>';

    const dislikeBtn = document.createElement('div');
    dislikeBtn.className = 'rating-btn rating-dislike';
    dislikeBtn.id = 'dislike-btn';
    if (window._isAlreadyRated) dislikeBtn.classList.add('rated');
    dislikeBtn.innerHTML = '👎 <span class="rating-count" id="dislike-count">0</span>';

    ratingBlock.appendChild(likeBtn);
    ratingBlock.appendChild(dislikeBtn);

    topBar.appendChild(onlineDisplay);
    topBar.appendChild(ratingBlock);
    topBar.appendChild(langBtn);
    menuBox.appendChild(topBar);
    // ===== КОНЕЦ БЛОКА РЕЙТИНГА =====

    const title = document.createElement('img');
    title.src = 'logotip.png';
    title.alt = 'Grid Loader';
    title.className = 'menu-title-logo';
    menuBox.appendChild(title);

    const subTitle = document.createElement('div');
    subTitle.className = 'menu-subtitle';
    menuBox.appendChild(subTitle);

    const tabsContainer = document.createElement('div');
    tabsContainer.className = 'menu-tabs-container';

    const tabButtons = [];
    const tabsData = [
        { id: 'start', ru: '🎮 Играть', en: '🎮 Play' },
        { id: 'about', ru: '📖 О игре', en: '📖 About' },
        { id: 'rules', ru: '💯 Очки', en: '💯 Rules' },
        { id: 'contacts', ru: '📞 Контакты', en: '📞 Contacts' },
    ];

    const contentBox = document.createElement('div');
    contentBox.className = 'menu-content-scroll';
    menuBox.appendChild(tabsContainer);
    menuBox.appendChild(contentBox);

    const donateLabel = lang === 'ru' ? '❤ ПОДДЕРЖАТЬ АВТОРА' : '❤ SUPPORT DEVELOPER';
    let donateButton = createTextureButton('knopka1spok.png', donateLabel);
    donateButton.onclick = () => { window.open('https://www.donationalerts.com/r/ruslik100', '_blank'); };

    const startLabel = lang === 'ru' ? 'НАЧАТЬ ИГРУ' : 'START GAME';
    const startButton = createTextureButton('knopka1spok.png', startLabel);

    menuBox.appendChild(startButton);
    menuBox.appendChild(donateButton);

    let activeTabId = 'start';

    function updateMenuLocalization() {
        const currentLang = window.gameLanguage;
        langBtn.innerText = `🌐 ${currentLang.toUpperCase()}`;
        
        tabButtons.forEach(btn => {
            const tabId = btn.dataset.id;
            const data = tabsData.find(t => t.id === tabId);
            const span = btn.querySelector('span');
            if (span) span.innerText = data[currentLang];
        });

        if (MENU_CONTENTS[activeTabId]) {
            contentBox.innerHTML = MENU_CONTENTS[activeTabId][currentLang];
        }

        const startSpan = startButton.querySelector('span');
        const donateSpan = donateButton.querySelector('span');
        
        if (currentLang === 'ru') {
            subTitle.innerText = ''; 
            if (startSpan) startSpan.innerText = 'НАЧАТЬ ИГРУ';
            if (donateSpan) donateSpan.innerText = '❤ ПОДДЕРЖАТЬ АВТОРА';
        } else {
            subTitle.innerText = ''; 
            if (startSpan) startSpan.innerText = 'START GAME';
            if (donateSpan) donateSpan.innerText = '❤ SUPPORT DEVELOPER';
        }
        window.updateOnlineText(currentOnlineCount);
    }

    function switchTab(tabId) {
        activeTabId = tabId;
        startButton.style.display = (tabId === 'start') ? 'inline-block' : 'none';
        
        tabButtons.forEach(btn => {
            const img = btn.querySelector('img');
            const span = btn.querySelector('span');
            if (btn.dataset.id === tabId) {
                if (img) img.src = 'knopka2active.png';
                if (span) { span.style.color = '#ffa801'; }
            } else {
                if (img) img.src = 'knopka2spok.png';
                if (span) { span.style.color = 'white'; }
            }
        });
        updateMenuLocalization();
    }

    tabsData.forEach(tab => {
        const wrapper = createTextureButton('knopka2spok.png', '');
        wrapper.dataset.id = tab.id;
        
        const span = document.createElement('span');
        span.innerText = tab[window.gameLanguage];
        span.className = 'texture-button-text';
        wrapper.appendChild(span);

        wrapper.onmouseover = () => {
            const img = wrapper.querySelector('img');
            if (img && wrapper.dataset.id !== activeTabId) img.src = 'knopka2active.png';
        };
        wrapper.onmouseout = () => {
            const img = wrapper.querySelector('img');
            if (img && wrapper.dataset.id !== activeTabId) img.src = 'knopka2spok.png';
        };
        wrapper.onclick = () => switchTab(tab.id);
        tabsContainer.appendChild(wrapper); 
        tabButtons.push(wrapper);
    });

    langBtn.onclick = () => {
        window.gameLanguage = window.gameLanguage === 'ru' ? 'en' : 'ru';
        localStorage.setItem('gameLang', window.gameLanguage);
        updateMenuLocalization();
        if (typeof window.refreshHtmlLabels === 'function') window.refreshHtmlLabels();
        if (typeof window.refreshGameInterfaceLang === 'function') window.refreshGameInterfaceLang();
    };

    startButton.onclick = () => {
        // FIX: Принудительная разблокировка AudioContext для Apple (iOS/iPadOS)
        if (window.phaserGameInstance && window.phaserGameInstance.sound && window.phaserGameInstance.sound.context) {
            const phaserCtx = window.phaserGameInstance.sound.context;
            if (phaserCtx.state === 'suspended') {
                phaserCtx.resume();
            }
        }
        
        const gamepad = document.querySelector('.mobile-gamepad');
        if (gamepad) gamepad.classList.add('gamepad-animate');
        if (cabinet) cabinet.classList.remove('arcade-cabinet-active');
        clearInterval(onlineInterval);
        
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (AudioContext) {
            const actx = new AudioContext();
            if (actx.state === 'suspended') actx.resume();
        }
        
        import('./sound.js').then(SoundModule => {
            SoundModule.startBackgroundMusic();
        });
        
        overlay.remove();
        if (window.phaserGameInstance && window.phaserGameInstance.input) {
            window.phaserGameInstance.input.enabled = true;
        }
        onStartGameCallback();
    };

    overlay.appendChild(menuBox);
    document.getElementById('game-screen').appendChild(overlay);

    // ===== ЛОГИКА РЕЙТИНГА =====
    const ratedKey = 'gridLoaderRated';
    let isRated = localStorage.getItem(ratedKey) === 'true';

    async function loadRating() {
        try {
            const res = await fetch('/api/rating');
            if (res.ok) {
                const data = await res.json();
                const likeEl = document.getElementById('like-count');
                const dislikeEl = document.getElementById('dislike-count');
                if (likeEl) likeEl.textContent = data.likes;
                if (dislikeEl) dislikeEl.textContent = data.dislikes;
            }
        } catch (e) {
            console.error('Ошибка загрузки рейтинга:', e);
        }
    }

    async function handleRating(type) {
        if (isRated || window._isAlreadyRated) {
            const currentLang = window.gameLanguage || 'ru';
            showRatingPopup(currentLang === 'ru' ? 'ВЫ УЖЕ ПОСТАВИЛИ СВОЮ ОЦЕНКУ!' : 'YOU HAVE ALREADY RATED THIS GAME!');
            return;
        }
        isRated = true;
        window._isAlreadyRated = true;

        const url = type === 'like' ? '/api/rating/like' : '/api/rating/dislike';
        try {
            const res = await fetch(url, { method: 'POST' });
            if (res.ok) {
                const data = await res.json();
                const likeEl = document.getElementById('like-count');
                const dislikeEl = document.getElementById('dislike-count');
                if (likeEl) likeEl.textContent = data.likes;
                if (dislikeEl) dislikeEl.textContent = data.dislikes;
            }
        } catch (e) {
            console.error('Ошибка отправки оценки:', e);
        }

        localStorage.setItem(ratedKey, 'true');

        // Блокируем кнопки
        likeBtn.classList.add('rated');
        dislikeBtn.classList.add('rated');

        // Показываем popup
        const currentLang = window.gameLanguage || 'ru';
        showRatingPopup(currentLang === 'ru' ? 'СПАСИБО ЗА ОЦЕНКУ!' : 'THANK YOU FOR RATING!');
    }

    // Обработчик вешается ВСЕГДА — проверка внутри функции
    likeBtn.onclick = () => handleRating('like');
    dislikeBtn.onclick = () => handleRating('dislike');

    loadRating();
    // ===== КОНЕЦ ЛОГИКИ РЕЙТИНГА =====

    switchTab('start');

    if (window.ysdk && window.ysdk.features && window.ysdk.features.LoadingAPI) {
        try {
            window.ysdk.features.LoadingAPI.gameReady();
        } catch (e) {
            console.warn("Ошибка вызова GameReady:", e);
        }
    }
}
