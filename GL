    setHeaders: (res, path) => {
        // Устанавливаем заголовки кэширования для статических файлов
        if (path.endsWith('.html')) {
            res.setHeader('Cache-Control', 'no-cache, no-store, must-revalidate');
            res.setHeader('Pragma', 'no-cache');
            res.setHeader('Expires', '0');
        } else if (path.match(/\.(png|jpg|gif|svg|ico|webp|jpeg)$/i)) {
            // Изображения кэшируем на 1 год — самая большая экономия (~1.8МБ)
            res.setHeader('Cache-Control', 'public, max-age=31536000, immutable');
            res.setHeader('Expires', new Date(Date.now() + 31536000000).toUTCString());
        } else if (path.match(/\.(js)$/i)) {
            // JS кэшируем на 1 месяц с версионированием
            res.setHeader('Cache-Control', 'public, max-age=2592000, immutable');
        } else if (path.match(/\.(css)$/i)) {
            res.setHeader('Cache-Control', 'public, max-age=2592000, immutable');
        } else if (path.match(/\.(ttf|woff|woff2|otf)$/i)) {
            // Шрифты кэшируем на 1 год
            res.setHeader('Cache-Control', 'public, max-age=31536000, immutable');
        } else if (path.match(/\.(json)$/i)) {
            res.setHeader('Cache-Control', 'public, max-age=300');
        }
    }
}));
