        <h2 id="title">🏆 ВСЕ УЧАСТНИКИ</h2>
        <div class="scores-list" id="full-list">Загрузка...</div>
        <a id="back-link" href="/" class="back-btn">⬅️ ВЕРНУТЬСЯ В ИГРУ</a>
    </div>

    <script>
        async function loadFullLeaderboard() {
            const listContainer = document.getElementById('full-list');
            const lang = localStorage.getItem('gameLang') || 'ru';
            
            if (lang === 'ru') {
                document.getElementById('title').innerText = "🏆 ВСЕ УЧАСТНИКИ";
                document.getElementById('back-link').innerText = "⬅️ ВЕРНУТЬСЯ В ИГРУ";
            } else {
                document.getElementById('title').innerText = "🏆 ALL PLAYERS";
                document.getElementById('back-link').innerText = "⬅️ BACK TO GAME";
            }

            try {
                const response = await fetch('/api/scores');
                const scores = await response.json();
                listContainer.innerHTML = '';

                if (scores.length === 0) {
                    listContainer.innerHTML = `<div style="text-align:center; color:#7f8c8d; margin-top:20px;">${lang === 'ru' ? 'Список пуст' : 'The list is empty'}</div>`;
                    return;
                }

                scores.forEach((entry, index) => {
                    const row = document.createElement('div');
                    row.className = 'row';
                    if (index === 0) row.style.color = '#f1c40f';
                    row.innerHTML = `<span>${index + 1}. ${entry.name}</span><b>${entry.score}</b>`;
                    listContainer.appendChild(row);
                });
            } catch (e) {
                listContainer.innerHTML = `<div style="text-align:center; color:#e74c3c; margin-top:20px;">Ошибка загрузки данных.</div>`;
            }
        }
        loadFullLeaderboard();
    </script>
</body>
</html>

