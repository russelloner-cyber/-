<!-- Масштабирование всей страницы — ОТКЛЮЧЕНО (edge-to-edge) -->
<script>
function scalePage() {
    const wrapper = document.getElementById('page-scale-wrapper');
    if (!wrapper) return;
    
    requestAnimationFrame(() => {
        const wrapperWidth = wrapper.scrollWidth;
        const wrapperHeight = wrapper.scrollHeight;
        
        if (wrapperWidth === 0 || wrapperHeight === 0) return;
        
        const availWidth = window.innerWidth;
        const availHeight = window.innerHeight;
        
        const scaleX = availWidth / wrapperWidth;
        const scaleY = availHeight / wrapperHeight;
        const scale = Math.min(scaleX, scaleY);
        
        // Масштабируем только если контент не влезает (scale < 1)
        // Нет искусственных ограничений — страница сжимается насколько нужно
        if (scale < 0.99) {
            wrapper.style.transform = `scale(${scale})`;
            wrapper.style.margin = '0 auto';
        } else {
            wrapper.style.transform = 'none';
            wrapper.style.margin = '0 auto';
        }
    });
}

// Масштабируем при загрузке и изменении размера (используем DOMContentLoaded, не load — конфликт с Phaser)
document.addEventListener('DOMContentLoaded', () => {
    setTimeout(scalePage, 200);
});
window.addEventListener('resize', () => {
    setTimeout(scalePage, 100);
});

// Также масштабируем при повороте экрана
window.addEventListener('orientationchange', () => {
    setTimeout(scalePage, 300);
});

// ===== ДИНАМИЧЕСКОЕ ПРИМЕНЕНИЕ МОБИЛЬНЫХ СТИЛЕЙ ЧЕРЕЗ JS =====
