        const { name, password, score } = req.body;
        if (!name || score === undefined) {
            return res.status(400).json({ success: false, error: "Missing data" });
        }
        let scores = [];
        if (fs.existsSync(DB_PATH)) {
            const data = fs.readFileSync(DB_PATH, 'utf8');
            scores = JSON.parse(data || '[]');
        }
        const newScore = parseInt(score);
        const lowerName = name.toLowerCase();
        
        // Ищем игрока в базе
        const existingPlayerIndex = scores.findIndex(entry => entry.name &&
            entry.name.toLowerCase() === lowerName);
            
        if (existingPlayerIndex !== -1) {
            const playerInDb = scores[existingPlayerIndex];
            
            // Если у старого игрока в базе вообще не было пароля, привязываем этот пароль к нему
            if (!playerInDb.password) {
                playerInDb.password = password || "";
