                // Если пароль есть и он не совпал — возвращаем ошибку авторизации
                return res.status(401).json({ success: false, error: "Неверный пароль для этого логина!" });
            }
            if (newScore > playerInDb.score) {
                playerInDb.score = newScore;
            }
        } else { 
            // Новый игрок — регистрируем логин, пароль и первый результат
            scores.push({ name, password: password || "", score: newScore });
        }
        
        // Сортировка ТОП-100
        scores.sort((a, b) => b.score - a.score);
        const topScores = scores.slice(0, 100); 
        fs.writeFileSync(DB_PATH, JSON.stringify(topScores, null, 2), 'utf-8');
        
        const cleanScores = topScores.map(entry => ({ name: entry.name, score: entry.score }));
        res.json({ success: true, scores: cleanScores });
