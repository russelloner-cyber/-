function createTextureButton(src, labelText) {
    const wrapper = document.createElement('div');
    wrapper.className = 'texture-button-wrapper';
    
    const img = document.createElement('img');
    img.src = src;
    img.dataset.defaultSrc = src;
    img.className = 'texture-button-img';
    
    if (labelText) {
        const span = document.createElement('span');
        span.innerText = labelText;
        span.className = 'texture-button-text';
        wrapper.appendChild(img);
        wrapper.appendChild(span);
    } else {
        wrapper.appendChild(img);
    }
    
    wrapper.onmouseover = () => { img.src = src.replace('spok', 'active'); };
    wrapper.onmouseout = () => { img.src = src.replace('active', 'spok'); };
    return wrapper;
}

