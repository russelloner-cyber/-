import { CONFIG } from './config.js';

export class Crane {
    constructor(scene) {
        this.scene = scene;
        
        // Создаем лебедку со стильной прорисованной 2D-текстурой
              this.sprite = scene.add.sprite(CONFIG.width / 2, 15, 'warehouse_crane');
               this.sprite.setDisplaySize(64, 26);
        this.sprite.setOrigin(0.5, 0.5);
        this.sprite.setAlpha(0.95);
        this.sprite.setDepth(10); // Отображаем кран поверх кирпичной стены
        
        // ТЕНЬ ПОД КРАНОМ
        this.shadow = this.scene.make.graphics();
        this.shadow.fillStyle(0x000000, 1);
        this.shadow.fillRect(0, 0, 64, 10);
        this.shadow.generateTexture('crane_shadow', 64, 6);
        this.shadow.destroy();
        this.shadowSprite = this.scene.add.sprite(CONFIG.width / 2, 15 + 13, 'crane_shadow');
        this.shadowSprite.setOrigin(0.5, 0.5);
        this.shadowSprite.setAlpha(0.2);
        this.shadowSprite.setDepth(5);
        
        this.direction = 1; // 1 — вправо, -1 — влево
        this.speed = 150; // Скорость движения лебедки
        this.currentCol = 0;
    }

    update(delta) {
        // ИСПРАВЛЕНИЕ: Переводим реальную дельту кадра из миллисекунд в секунды
        // Теперь скорость крана будет абсолютно одинаковой на 60Гц, 144Гц или 30FPS!
        const dt = delta / 1000;
        this.sprite.x += this.speed * this.direction * dt;

        // Корректируем границы отскока с учетом ширины крана (32 пикселя от краев)
        if (this.sprite.x > CONFIG.width - 32) {
            this.sprite.x = CONFIG.width - 32;
            this.direction = -1;
        } else if (this.sprite.x < 32) {
            this.sprite.x = 32;
            this.direction = 1;
        }

        // Рассчитываем колонку сброса строго по центральной оси лебедки
        this.currentCol = Math.floor(this.sprite.x / CONFIG.blockSize);
        
        // Обновляем позицию тени вместе с краном
        this.shadowSprite.x = this.sprite.x;
        this.shadowSprite.y = this.sprite.y + 13;
    }

    getDropColumn() {
        if (this.currentCol >= 0 && this.currentCol < CONFIG.cols) {
            return this.currentCol;
        }
        return null;
    }
}

