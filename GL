import { CONFIG } from './config.js';
import { playStepSound, playJumpSound } from './sound.js';

export class Player extends Phaser.GameObjects.Container {
  constructor(scene, x, y) {
    super(scene, x, y);
    
    scene.add.existing(this);
    scene.physics.add.existing(this);
    
    this.body.setCollideWorldBounds(true);
    this.body.setGravityY(1300);

    // НАДЕЖНЫЙ СТАТИЧНЫЙ ХИТБОКС (НИКОГДА НЕ СДВИГАЕТСЯ)
    this.body.setSize(16, 32);
    this.body.setOffset(-8, -16); // Центрируем тело один раз на старте

    this.timeCounter = 0; 
    this.blinkTimer = 0;  

    // Создаем визуальные слои персонажа
    this.legL = scene.add.sprite(-4, 8, 'p_leg').setOrigin(0.5, 0);
    this.legR = scene.add.sprite(4, 8, 'p_leg').setOrigin(0.5, 0);
    this.torso = scene.add.sprite(0, 0, 'p_body').setOrigin(0.5, 0.5);
    this.head = scene.add.sprite(0, -12, 'p_head').setOrigin(0.5, 0.5);
    this.eyeL = scene.add.sprite(-2, -10, 'p_eye_closed').setOrigin(0.5, 0.5).setVisible(false);
    this.eyeR = scene.add.sprite(2, -10, 'p_eye_closed').setOrigin(0.5, 0.5).setVisible(false);
    this.armL = scene.add.sprite(-7, -4, 'p_arm').setOrigin(0.5, 0);
    this.armR = scene.add.sprite(7, -4, 'p_arm').setOrigin(0.5, 0);

    this.add([this.legL, this.legR, this.torso, this.head, this.eyeL, this.eyeR, this.armL, this.armR]);
  }

  update(cursors, wasd, grid, delta) {
    const moveSpeed = 240;
    const jumpVelocity = -450;
    const isGrounded = this.body.blocked.down || this.body.touching.down;

    let isMoving = false;
    const leftDown = cursors.left.isDown || wasd.left.isDown;
    const rightDown = cursors.right.isDown || wasd.right.isDown;
    const upDown = cursors.up.isDown || wasd.up.isDown;

    // 1. ДВИЖЕНИЕ С БЕЗОПАСНЫМ РАЗВОРОТОМ СЛОЕВ
    if (leftDown) {
      this.body.setVelocityX(-moveSpeed);
      isMoving = true;
      
      // Разворачиваем только картинки, не трогая сам контейнер и его хитбокс!
      this.head.flipX = true;
      this.torso.flipX = true;
      this.armL.flipX = true;
      this.armR.flipX = true;
      this.legL.flipX = true;
      this.legR.flipX = true;

      // Меняем местами координаты рук и ног для левой стороны
      this.legL.x = 4;   this.legR.x = -4;
      this.armL.x = 7;   this.armR.x = -7;
    } else if (rightDown) {
      this.body.setVelocityX(moveSpeed);
      isMoving = true;
      
      // Возвращаем картинки в исходное правое положение
      this.head.flipX = false;
      this.torso.flipX = false;
      this.armL.flipX = false;
      this.armR.flipX = false;
      this.legL.flipX = false;
      this.legR.flipX = false;

      // Исходные правые координаты частей тела
      this.legL.x = -4;  this.legR.x = 4;
      this.armL.x = -7;  this.armR.x = 7;
    } else {
      this.body.setVelocityX(0);
    }

    // 2. ПРЫЖОК СО ЗВУКОМ
    if (upDown && isGrounded) {
      this.body.setVelocityY(jumpVelocity);
      playJumpSound(); // ВОССТАНОВЛЕНО: Четкий звук ретро-прыжка [INDEX]
    }

    // 3. ПОЛНАЯ МАТЕМАТИЧЕСКАЯ АНИМАЦИЯ КОНЕЧНОСТЕЙ (ВОССТАНОВЛЕНО!)
    if (isMoving) {
      this.timeCounter += delta * 0.015; 
      
      // АКТИВАЦИЯ ЗВУКА ШАГОВ: Проигрываем звук шага строго по фазе синусоиды махов ногами [INDEX]
      if (isGrounded && Math.floor(this.timeCounter * 3.5) % 4 === 0 && Phaser.Math.Between(0, 100) > 65) {
          playStepSound();
      }
    } else {
      this.timeCounter += delta * 0.002; 
    }

    const modifier = leftDown ? -1 : 1;

    if (!isGrounded) {
      // Анимация в полете: поджимаем ноги, вскидываем руки вверх
      this.legL.setAngle(25 * modifier);
      this.legR.setAngle(-25 * modifier);
      this.armL.setAngle(-120 * modifier);
      this.armR.setAngle(-120 * modifier);
      this.head.y = -11;
    } else if (isMoving) {
      // Анимация бега: размашистые противофазные махи руками и ногами
      let legWave = Math.sin(this.timeCounter) * 35 * modifier;
      this.legL.setAngle(legWave);
      this.legR.setAngle(-legWave);

      let armWave = Math.sin(this.timeCounter) * 25 * modifier;
      this.armL.setAngle(-armWave);
      this.armR.setAngle(armWave);

      // Жилетка и каска мягко прыгают вверх-вниз в такт шагам
      this.torso.y = 0 + Math.abs(Math.sin(this.timeCounter)) * 2;
      this.head.y = -12 + Math.abs(Math.sin(this.timeCounter)) * 1.5;
    } else {
      // Анимация покоя (Idle): конечности сбрасываются, тело плавно "дышит"
      this.legL.setAngle(0);
      this.legR.setAngle(0);
      this.armL.setAngle(Math.sin(this.timeCounter * 2) * 5 * modifier);
      this.armR.setAngle(-Math.sin(this.timeCounter * 2) * 5 * modifier);
      
      let breatheWave = Math.sin(this.timeCounter * 2) * 0.6;
      this.torso.y = 0 + breatheWave;
      this.head.y = -12 + breatheWave;
    }

    // 4. ТАЙМЕР ПЕРИОДИЧЕСКОГО МОРГАНИЯ ГЛАЗ (ВОССТАНОВЛЕНО!)
    this.blinkTimer += delta;
    if (this.blinkTimer > 3000) { 
      this.eyeL.setVisible(true);
      this.eyeR.setVisible(true);
      if (this.blinkTimer > 3150) {
        this.eyeL.setVisible(false);
        this.eyeR.setVisible(false);
        this.blinkTimer = Phaser.Math.Between(0, 1000); 
      }
    }

    // Расчет матричных координат для ядра игры
    this.gridX = Math.floor(this.x / CONFIG.blockSize);
    this.gridY = Math.floor(this.y / CONFIG.blockSize);
  }
    playDeathAnimation() {
        // 1. Отключаем физическое тело, чтобы он перестал падать или бегать
        if (this.body) {
            this.body.enable = false;
        }

        // 2. Намертво включаем спрайты закрытых глаз (p_eye_closed), которые у нас уже созданы
        if (this.eyeL) this.eyeL.setVisible(true);
        if (this.eyeR) this.eyeR.setVisible(true);

        // 3. Запускаем красивую анимацию падения на бок всего контейнера
        this.scene.tweens.add({
            targets: this,
            rotation: Math.PI / 2, // Поворачиваем на 90 градусов (ложится на бок)
            y: this.y + CONFIG.blockSize / 3, // Смещаем чуть ближе к полу, чтобы падение выглядело естественно
            duration: 350, // Длительность падения в миллисекундах
            ease: 'Bounce.out' // Эффект забавного ретро-отскока при ударе об землю
        });
    }

}

