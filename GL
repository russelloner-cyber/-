// Модуль сочных пиксельных спецэффектов Grid Loader
export function createLineExplosionEffect(scene, x, y, textureKey) {
    // --- 1. ДОБАВЛЯЕМ ЭФФЕКТ ТРЯСКИ ЭКРАНА (SCREEN SHAKE) ---
    scene.cameras.main.shake(200, 0.015, true);

    // --- 2. ГЕНЕРАЦИЯ ОБЛАКОВ ПИКСЕЛЬНОГО ДЫМА (БЕЗ УТЕЧЕК ПАМЯТИ) ---
    const smokeCount = 6;
    for (let s = 0; s < smokeCount; s++) {
        const offsetX = Phaser.Math.FloatBetween(-15, 15);
        const offsetY = Phaser.Math.FloatBetween(-15, 15);
        
        // Используем готовую статичную текстуру из theme.js вместо генерации новой
        const smoke = scene.add.sprite(x + offsetX, y + offsetY, 'smoke_particle_static');
        smoke.setDepth(4); 
        
        // Случайный оттенок серого цвета для разнообразия облаков дыма
        const grayTone = Phaser.Math.Between(180, 220);
        const smokeColor = Phaser.Display.Color.GetColor(grayTone, grayTone, grayTone);
        smoke.setTint(smokeColor);

        const smokeVx = Phaser.Math.FloatBetween(-40, 40);
        const smokeVy = Phaser.Math.FloatBetween(-80, -30); 

        scene.tweens.add({
            targets: smoke,
            x: smoke.x + (smokeVx * 0.6),
            y: smoke.y + (smokeVy * 0.6),
            scaleX: 2.2, 
            scaleY: 2.2,
            alpha: 0, 
            duration: Phaser.Math.Between(500, 800), 
            ease: 'Cubic.out',
            onComplete: () => {
                smoke.destroy(); // Просто удаляем спрайт, память VRAM теперь в безопасности!
            }
        });
    }

    // --- 3. ГЕНЕРАЦИЯ ЛЕТЯЩИХ ОЩЕПОК ЯЩИКА ---
    const particlesCount = 12;
    for (let i = 0; i < particlesCount; i++) {
        const particle = scene.add.sprite(x, y, textureKey);
        particle.setScale(0.25);
        particle.setDepth(5);
        const angle = Phaser.Math.FloatBetween(0, Math.PI * 2);
        const speed = Phaser.Math.FloatBetween(120, 280);
        
        const vx = Math.cos(angle) * speed;
        const vy = Math.sin(angle) * speed;
        const duration = Phaser.Math.Between(400, 700);

        scene.tweens.add({
            targets: particle,
            x: x + (vx * (duration / 1000)),
            y: y + (vy * (duration / 1000)) + (0.5 * 650 * Math.pow(duration / 1000, 2)),
            rotation: Phaser.Math.FloatBetween(2, 6),
            duration: duration,
            ease: 'Linear',
            onComplete: () => {
                scene.tweens.add({
                    targets: particle,
                    alpha: 0,
                    duration: 150,
                    onComplete: () => particle.destroy()
                });
            }
        });
    }
}

// Запасная функция эффекта удара/падения для совместимости с другими модулями
