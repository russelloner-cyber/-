  if (event.touches.length === 1) {
    event.preventDefault();
  }
}, { passive: false });

// Глушение Web Audio API при потере фокуса вкладки
document.addEventListener('visibilitychange', () => {
  handleVisibilityChange(document.hidden);
});

// Симуляция нажатий клавиш для мобильного тач-пада
const simulateKeyEvent = (type, keyCode, keyName) => {
  const event = new KeyboardEvent(type, {
    bubbles: true,
    cancelable: true,
    keyCode: keyCode,
    key: keyName,
    code: keyName
  });
  document.dispatchEvent(event);
};

const setupMobileKey = (elementId, imgId, activeSrc, inactiveSrc, keyCode, keyName) => {
  const el = document.getElementById(elementId);
  const img = document.getElementById(imgId);
  if (!el || !img) return;

  el.addEventListener('touchstart', (e) => { 
    e.preventDefault(); 
    img.src = activeSrc;
    simulateKeyEvent('keydown', keyCode, keyName); 
  }, { passive: false });

  el.addEventListener('touchend', (e) => { 
    e.preventDefault(); 
    img.src = inactiveSrc;
    simulateKeyEvent('keyup', keyCode, keyName); 
  }, { passive: false });

  el.addEventListener('touchcancel', (e) => { 
    e.preventDefault(); 
    img.src = inactiveSrc;
    simulateKeyEvent('keyup', keyCode, keyName); 
  }, { passive: false });

  // FIX: Защита от залипания кнопок геймпада на iOS — отжимаем при выходе пальца за пределы
  el.addEventListener('touchmove', (e) => {
    const touch = e.touches[0];
    const rect = el.getBoundingClientRect();
    if (touch.clientX < rect.left || touch.clientX > rect.right || touch.clientY < rect.top || touch.clientY > rect.bottom) {
      img.src = inactiveSrc;
      simulateKeyEvent('keyup', keyCode, keyName);
    }
  }, { passive: true });
};

