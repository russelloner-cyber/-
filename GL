// ===== ОПРЕДЕЛЕНИЕ МОБИЛЬНОГО УСТРОЙСТВА =====
function detectMobileAndApplyMode() {
    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    const isMobileUA = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Mobile|Tablet/i.test(navigator.userAgent);
    const isNarrowScreen = window.innerWidth <= 768;
    
    // Мобильный режим если:
    // 1) touch-устройство (планшеты и мобильные)
    // 2) ИЛИ мобильный User Agent
    // 3) ИЛИ узкий экран <= 768px
    const shouldEnableMobile = isTouchDevice || isMobileUA || isNarrowScreen;
    
    if (shouldEnableMobile) {
        injectMobileStyles();
        // Скрываем футер и SEO-блок через JS
        var footer = document.getElementById('site-footer');
        if (footer) {
            footer.style.display = 'none';
            footer.style.visibility = 'hidden';
            footer.style.height = '0';
            footer.style.overflow = 'hidden';
        }
        var seoBlock = document.querySelector('.game-description-container');
        if (seoBlock) {
            seoBlock.style.display = 'none';
            seoBlock.style.visibility = 'hidden';
            seoBlock.style.height = '0';
            seoBlock.style.overflow = 'hidden';
        }
        console.log('[MOBILE] Мобильный режим включён (touch:', isTouchDevice, ', UA:', isMobileUA, ', narrow:', isNarrowScreen, ')');
    } else {
        removeMobileStyles();
        // Показываем обратно на десктопе
        var footer = document.getElementById('site-footer');
        if (footer) {
            footer.style.display = '';
            footer.style.visibility = '';
            footer.style.height = '';
            footer.style.overflow = '';
        }
        var seoBlock = document.querySelector('.game-description-container');
        if (seoBlock) {
            seoBlock.style.display = '';
            seoBlock.style.visibility = '';
            seoBlock.style.height = '';
            seoBlock.style.overflow = '';
        }
        console.log('[MOBILE] Мобильный режим выключен');
    }
}

// Проверяем при загрузке (сразу, без задержки)
detectMobileAndApplyMode();

// Принудительно применяем стили через 500мс после загрузки
setTimeout(() => {
    detectMobileAndApplyMode();
    console.log('[MOBILE] Повторная проверка через 500мс');
}, 500);

// Также применяем при первом касании
document.addEventListener('touchstart', () => {
    detectMobileAndApplyMode();
    console.log('[MOBILE] Применение при первом касании');
}, { once: true });

// Проверяем при изменении размера окна
window.addEventListener('resize', () => {
