// ФАЙЛ: core.js — ЧАСТЬ 1
import { CONFIG } from './config.js';
import { Player } from './player.js';
import { Crane } from './background.js';
import { createLineExplosionEffect } from './effects.js';
import { playExplosionSound, playLandSound, playPushSound, playChaosSiren, stopChaosSiren, stopBackgroundMusic, gameFlags } from './sound.js';

let player = null, crane = null, grid = null, currentScore = null, spawnTimer = 0;
let isBlackoutActive = false, blackoutGraphics = null, blackoutOverlay = null;
let isRestingAfterAnomaly = false, isGameOverFlag = false, isChaosActive = false;
let chaosTimer = 0, chaosChanceTimer = 0, checkLinesTimeout = null;
let currentComboStreak = 1, comboStreakTimer = null;

export function initGameCore(scene, scoreObject) {
  currentScore = scoreObject; 
  isGameOverFlag = false; 
  spawnTimer = 0;
  isChaosActive = false; 
  chaosTimer = 0; 
  chaosChanceTimer = 0; 
  CONFIG.spawnRate = 2000; 
  currentComboStreak = 1; 
  
  // FIX: Правильный метод destroy() вместо remove()
  if (comboStreakTimer) { 
    comboStreakTimer.destroy(); 
    comboStreakTimer = null; 
  }
  
  grid = [];
  for (let r = 0; r < CONFIG.rows; r++) { 
    grid.push(new Array(CONFIG.cols).fill(null)); 
  }
  
  gameFlags.isGameActive = true; // Игра началась
  
  // FIX: Memory leak — уничтожаем старую группу перед созданием новой
  if (scene.physicsBoxesGroup) {
    scene.physicsBoxesGroup.clear(true, true);
    scene.physicsBoxesGroup.destroy();
  }
  scene.physicsBoxesGroup = scene.physics.add.group({ immovable: true, allowGravity: false });
  player = new Player(scene, CONFIG.width / 2, CONFIG.height - CONFIG.blockSize / 2);
  crane = new Crane(scene); 
  
  scene.physics.add.collider(player, scene.physicsBoxesGroup, (playerObj, boxObj) => {
    if (isGameOverFlag) return;
    if (playerObj.body.y + playerObj.body.height <= boxObj.body.y + 6) {
      if (playerObj.body.velocity.y > 0) playerObj.body.setVelocityY(0); 
    }
  });
}
// ФАЙЛ: core.js — ЧАСТЬ 2
export function updateGameCore(scene, delta, customCursors = null) {
  if (isGameOverFlag || !player || !grid || !crane) return;
  const cursors = customCursors || scene.input.keyboard.createCursorKeys();
  const wasd = scene.input.keyboard.addKeys({
    left: Phaser.Input.Keyboard.KeyCodes.A,
    right: Phaser.Input.Keyboard.KeyCodes.D,
    up: Phaser.Input.Keyboard.KeyCodes.W
  });
  player.update(cursors, wasd, grid, delta); 
  // ЭФФЕКТ ПАРАЛЛАКСА:
    if (scene.background && player) {
        const playerOffsetFromCenter = player.x - (CONFIG.width / 2);
        scene.background.x = (CONFIG.width / 2) - (playerOffsetFromCenter * 0.15);
    }
  crane.update(delta);
  
  let direction = 0;
  if (cursors.left.isDown || wasd.left.isDown) direction = -1; 
  else if (cursors.right.isDown || wasd.right.isDown) direction = 1;
  
  if (direction !== 0) {
    let pGridX = Math.floor(player.x / CONFIG.blockSize), pGridY = Math.floor(player.y / CONFIG.blockSize);
    let targetBoxX = pGridX + direction, targetBoxY = pGridY; 
    
    if (targetBoxX >= 0 && targetBoxX < CONFIG.cols && targetBoxY >= 0 && targetBoxY < CONFIG.rows) {
      let boxObj = grid[targetBoxY][targetBoxX];
      
      if (boxObj && !boxObj.isFalling && Math.abs(player.x - boxObj.x) <= CONFIG.blockSize * 1.1) {
        let nextEmptyX = targetBoxX + direction;
        
        if (nextEmptyX >= 0 && nextEmptyX < CONFIG.cols && grid[targetBoxY][nextEmptyX] === null) {
          let hasFallingBoxAbove = (targetBoxY - 1 >= 0 && grid[targetBoxY - 1][targetBoxX] !== null && grid[targetBoxY - 1][targetBoxX].isFalling);
          
          if (hasFallingBoxAbove) {
            // Мгновенное уничтожение нижнего ящика под прессом верхнего
            playExplosionSound(); 
            createLineExplosionEffect(scene, boxObj.x, boxObj.y, boxObj.texture.key);
            scene.physicsBoxesGroup.remove(boxObj, true, true); 
            grid[targetBoxY][targetBoxX] = null;
            playPushSound();
            checkBoxesPhysics(scene, 0);
          } else {
            // Обычный безопасный сдвиг ящика в сторону
            grid[targetBoxY][nextEmptyX] = boxObj; 
            grid[targetBoxY][targetBoxX] = null; 
            boxObj.gridCol = nextEmptyX; 
            boxObj.isFalling = true; 
            playPushSound(); 
            
            scene.tweens.add({
              targets: boxObj, 
              x: nextEmptyX * CONFIG.blockSize + CONFIG.blockSize / 2, 
              duration: 110,
              onUpdate: () => { 
                if (boxObj && boxObj.body) boxObj.body.x = boxObj.x - CONFIG.blockSize / 2; 
              },
              onComplete: () => {
                boxObj.isFalling = false;
                if (boxObj && boxObj.body) { 
                  boxObj.body.x = boxObj.x - CONFIG.blockSize / 2; 
                  boxObj.body.y = boxObj.y - CONFIG.blockSize / 2; 
                }
                checkBoxesPhysics(scene, 0);
              }
            });
          }
        }
      }
    }
  }
  
  if (!isChaosActive && !isBlackoutActive && !isRestingAfterAnomaly) {
    chaosChanceTimer += delta;
    if (chaosChanceTimer >= 10000) { 
      chaosChanceTimer = 0;
      if (currentScore && currentScore.value >= 100 && Phaser.Math.Between(1, 100) <= 20) { 
        if (Phaser.Math.Between(1, 2) === 1) {
          isChaosActive = true; chaosTimer = 5000; CONFIG.spawnRate = 450; window.isChaosModeActive = true; playChaosSiren();
          scene.cameras.main.shake(5000, 0.012, true); 
          scene.cameras.main.flash(500, 255, 0, 0); scene.cameras.main.fade(5000, 150, 0, 0, true); 
        } else {
          isBlackoutActive = true; 
                chaosTimer = 5000; 
                blackoutOverlay = document.createElement('div');
                blackoutOverlay.style = "position: absolute; pointer-events: none; z-index: 999; top: 0; left: 0; width: 100%; height: 100%;";
                
                const gameContainer = document.getElementById('game-screen');
                if (gameContainer) {
                    gameContainer.appendChild(blackoutOverlay);
                }
                 }
      }
    } 
  } else {
    chaosTimer -= delta;
    if (isBlackoutActive && blackoutOverlay && player) {
      // FIX: Используем экранные координаты Phaser — getBoundingClientRect ломается на iOS Safari
      const cam = scene.cameras.main;
      const playerScreenX = (player.x - cam.scrollX) * cam.zoom * (scene.game.scale.displaySize.width / CONFIG.width);
      const playerScreenY = (player.y - cam.scrollY) * cam.zoom * (scene.game.scale.displaySize.height / CONFIG.height);

      blackoutOverlay.style.background = `radial-gradient(circle at ${playerScreenX}px ${playerScreenY}px, transparent 45px, rgba(10, 15, 20, 0.97) 85px)`;
    }
    if (chaosTimer <= 0) {
      chaosChanceTimer = 0; isRestingAfterAnomaly = true;
      scene.time.delayedCall(20000, () => { isRestingAfterAnomaly = false; });
      if (isChaosActive) {
        isChaosActive = false; window.isChaosModeActive = false; stopChaosSiren(); CONFIG.spawnRate = Math.max(600, 2000 - (currentScore.value / 100) * 40);

        scene.cameras.main.fadeIn(500, 0, 0, 0);
      }
      if (isBlackoutActive) { isBlackoutActive = false; if (blackoutOverlay) { blackoutOverlay.remove(); blackoutOverlay = null; } }
    }
  }
  
  spawnTimer += delta;
  if (spawnTimer >= CONFIG.spawnRate) {
    let col = crane.getDropColumn();
    if (isChaosActive && player && col !== null) {
      let playerCol = Math.floor(player.x / CONFIG.blockSize);
      if (col === playerCol || col === playerCol - 1 || col === playerCol + 1) col = (col + 2) % CONFIG.cols; 
    }
    if (col !== null && col >= 0 && col < CONFIG.cols) { dropBox(scene, col); }
    spawnTimer = 0;
  }
  checkBoxesPhysics(scene, delta);
}
// ФАЙЛ: core.js — ЧАСТЬ 3
function dropBox(scene, col) {
  let textures = ['box_wood', 'box_cargo', 'box_metal', 'box_fragile', 'box_military', 'box_bio', 'box_precious', 'box_ice', 'box_toxic'];
  let tex = textures[Math.floor(Math.random() * textures.length)];
  let box = scene.physicsBoxesGroup.create(col * CONFIG.blockSize + CONFIG.blockSize / 2, CONFIG.blockSize / 2, tex);
  box.setOrigin(0.5, 0.5); box.gridCol = col; box.gridRow = 0; box.isFalling = true;
  if (box.body) { box.body.setImmovable(true); box.body.setSize(CONFIG.blockSize, CONFIG.blockSize); }
  startBoxFalling(scene, box);
}

function startBoxFalling(scene, box) {
  if (!box || !box.active || isGameOverFlag) return;
  let nextRow = box.gridRow + 1, hitFloor = (nextRow >= CONFIG.rows), hitBlock = false;
  if (!hitFloor && grid[nextRow] && grid[nextRow][box.gridCol] !== null) hitBlock = true;
  
  if (hitFloor || hitBlock) {
    box.isFalling = false;
    box.y = Math.floor(box.gridRow * CONFIG.blockSize) + CONFIG.blockSize / 2;
    box.x = Math.floor(box.gridCol * CONFIG.blockSize) + CONFIG.blockSize / 2;
    
    if (grid[box.gridRow] && grid[box.gridRow][box.gridCol] !== null) {
      let existingBox = grid[box.gridRow][box.gridCol];
      playExplosionSound(); createLineExplosionEffect(scene, box.x, box.y, box.texture.key);
      scene.physicsBoxesGroup.remove(existingBox, true, true); 
      grid[box.gridRow][box.gridCol] = null;
    }
    
    if (box.gridRow === 0 && grid[box.gridCol] !== null) { triggerGameOver(scene); return; }
    if (grid[box.gridRow]) grid[box.gridRow][box.gridCol] = box;
    if (box.body) { box.body.x = box.x - CONFIG.blockSize / 2; box.body.y = box.y - CONFIG.blockSize / 2; }
    playLandSound();
    
    // FIX: destroy() вместо remove()
    if (checkLinesTimeout) checkLinesTimeout.destroy();
    checkLinesTimeout = scene.time.delayedCall(50, () => { checkLines(scene); });
  } else {
    box.isFalling = true; box.gridRow = nextRow;
    scene.tweens.add({
      targets: box, y: nextRow * CONFIG.blockSize + CONFIG.blockSize / 2, duration: 150,
      onUpdate: () => {
        if (box && box.body) box.body.y = box.y - CONFIG.blockSize / 2;
        if (player && player.body) {
          let boxBottom = box.y + CONFIG.blockSize / 2, playerTop = player.y - player.body.height / 2, playerBottom = player.y + player.body.height / 2;
          if (box.gridCol === Math.floor(player.x / CONFIG.blockSize) && boxBottom >= playerTop + 6 && boxBottom <= playerBottom) {
            triggerGameOver(scene); return;
          }
        }
      },
      onComplete: () => { if (box && box.active && !isGameOverFlag) startBoxFalling(scene, box); }
    });
  }
}

export function checkBoxesPhysics(scene, delta) {
  if (!grid || isGameOverFlag) return;
  for (let r = CONFIG.rows - 2; r >= 0; r--) {
    for (let c = 0; c < CONFIG.cols; c++) {
      let box = grid[r][c];
      if (box && !box.isFalling && grid[r + 1][c] === null) {
        grid[r][c] = null; box.gridRow = r; box.isFalling = true; startBoxFalling(scene, box);
      }
    }
  }
}

function checkLines(scene) {
  let linesToClear = [];
  for (let r = 0; r < CONFIG.rows; r++) {
    let blockCount = 0;
    for (let c = 0; c < CONFIG.cols; c++) { if (grid[r][c]) blockCount++; }
    if (blockCount === CONFIG.cols) linesToClear.push(r);
  }
  const clearedCount = linesToClear.length;
  if (clearedCount === 0) { applyGravity(scene); return; }
  
  let pointsGained = clearedCount * 100 * currentComboStreak; 
  playExplosionSound();
  
  linesToClear.forEach(r => {
    for (let c = 0; c < CONFIG.cols; c++) {
      let box = grid[r][c];
      if (box) { createLineExplosionEffect(scene, box.x, box.y, box.texture.key); scene.physicsBoxesGroup.remove(box, true, true); }
      grid[r][c] = null;
    }
  });
  
  if (currentScore) {
    currentScore.value += pointsGained;
    if (!isChaosActive) CONFIG.spawnRate = Math.max(600, 2000 - (currentScore.value / 100) * 40);
    if (currentScore.text) currentScore.text.setText(""); 
    const lang = window.gameLanguage || 'ru';
    let comboPhrase = lang === 'ru' ? `ЛИНИЯ ОЧИЩЕНА! СЧЁТ +${pointsGained}` : `LINE CLEAR! SCORE +${pointsGained}`;
    let textFillColor = '#3498db'; 
    if (currentComboStreak > 1) {
      comboPhrase = lang === 'ru' ? `СЕРИЯ Х${currentComboStreak}! +${pointsGained}` : `STREAK Х${currentComboStreak}! +${pointsGained}`;
      textFillColor = currentComboStreak >= 3 ? '#e74c3c' : '#f1c40f'; 
    }
    let comboAnnounce = scene.add.text(CONFIG.width / 2, CONFIG.height / 2 - 40, comboPhrase, {
      fontSize: currentComboStreak >= 3 ? '24px' : '20px', fill: textFillColor, fontFamily: 'Courier New, Courier, monospace', fontWeight: '900', stroke: '#1a1a1a', strokeThickness: 4, shadow: { offsetX: 2, offsetY: 2, color: '#000000', blur: 3, stroke: true, fill: true }
    }).setOrigin(0.5).setDepth(100);
    scene.tweens.add({
      targets: comboAnnounce, y: comboAnnounce.y - 70, scaleX: 1.3, scaleY: 1.3, alpha: 0, duration: 3500, ease: 'Cubic.easeOut', onComplete: () => { comboAnnounce.destroy(); }
    });
    if (comboStreakTimer) comboStreakTimer.destroy();
    currentComboStreak++; 
    comboStreakTimer = scene.time.delayedCall(6000, () => { currentComboStreak = 1; });
  }
  applyGravity(scene);
}

function applyGravity(scene) {
  for (let dropRow = CONFIG.rows - 1; dropRow >= 0; dropRow--) {
    for (let c = 0; c < CONFIG.cols; c++) {
      let upperBox = grid[dropRow][c];
      if (upperBox) {
        let emptyRow = dropRow;
        while (emptyRow + 1 < CONFIG.rows && grid[emptyRow + 1][c] === null) emptyRow++;
        if (emptyRow !== dropRow) {
          grid[emptyRow][c] = upperBox; grid[dropRow][c] = null;
          scene.tweens.add({ targets: upperBox, y: emptyRow * CONFIG.blockSize + CONFIG.blockSize / 2, duration: 200 });
        }
      }
    }
  }
}

function triggerGameOver(scene) {
  if (isGameOverFlag) return;
  isGameOverFlag = true;
  gameFlags.isGameActive = false; // Игра закончилась
  if (player && typeof player.playDeathAnimation === 'function') player.playDeathAnimation();
  stopBackgroundMusic(); stopChaosSiren();
    if (comboStreakTimer) { comboStreakTimer.destroy(); comboStreakTimer = null; }
  if (blackoutOverlay) { if (blackoutOverlay.parentNode) blackoutOverlay.remove(); blackoutOverlay = null; }
  if (isBlackoutActive) isBlackoutActive = false;
  
  import('./menu.js').then(M => { M.showGameOverMenu(currentScore.value); });
}

