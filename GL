    playTone(65, 'triangle', 0.05, 0.06, 35);
}

// НАДЕЖНОЕ РЕТРО-ШУРШАНИЕ "ШЫ-ШЫ-ШЫ" ДЛЯ ТОЛКАНИЯ ЯЩИКА (ТИХОЕ И НАДЁЖНОЕ)
export function playPushSound() {
    if (!isSFXEnabled) return;
    initAudio();
    if (!audioCtx || audioCtx.state === 'suspended') return;
    const osc = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    const lowpassFilter = audioCtx.createBiquadFilter();
    const highpassFilter = audioCtx.createBiquadFilter();

    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(100, audioCtx.currentTime);
    osc.frequency.linearRampToValueAtTime(30, audioCtx.currentTime + 0.15);

    highpassFilter.type = 'highpass';
    highpassFilter.frequency.setValueAtTime(180, audioCtx.currentTime);

    lowpassFilter.type = 'lowpass';
    lowpassFilter.frequency.setValueAtTime(450, audioCtx.currentTime);

    gainNode.gain.setValueAtTime(0.04, audioCtx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.15);

    osc.connect(highpassFilter);
    highpassFilter.connect(lowpassFilter);
    lowpassFilter.connect(gainNode);
    gainNode.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime + 0.15);
}

