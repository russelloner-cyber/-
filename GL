import { toggleMusic, toggleSFX, isMusicEnabled, isSFXEnabled } from './sound.js';
import { INTERFACE_LABELS } from './langConfig.js';

const PREFIXES = { ru: 'СЧЕТ:', en: 'SCORE:' };

// Объявляем ссылки на элементы интерфейса глобально внутри модуля
let scoreTextRef = null;
let musicBtnRef = null;
let sfxBtnRef = null;
let currentScoreObject = null;

export function createGameInterface(scene, scoreObject) {
 const lang = window.gameLanguage || 'ru';
 currentScoreObject = scoreObject;

      scoreTextRef = scene.add.text(10, 33, PREFIXES[lang] + '0000', {
         fontFamily: "'DigitTech14', monospace",
         fontSize: '25px',
         color: '#ff8c00',
         backgroundColor: 'rgba(0, 0, 0, 0.36)',
         padding: { x: 8, y: 4 },
         letterSpacing: 1,
         stroke: '#1a1a1a',
         strokeThickness: 2,
         shadow: { offsetX: 0, offsetY: 0, color: '#ff8c00', blur: 10, fill: true, stroke: true }
      }).setOrigin(0, 0).setDepth(100);

     // Ждем загрузки веб-шрифта DigitTech14 и перерисовываем текст, если шрифт пришел позже
     if (document.fonts && typeof document.fonts.load === 'function') {
        document.fonts.load('25px "DigitTech14"').then(() => {
          if (scoreTextRef && scoreTextRef.active) scoreTextRef.setText(scoreTextRef.text);
        }).catch(() => {});
     }

scoreObject.text = scoreTextRef;

      sfxBtnRef = scene.add.text(160, 33, isSFXEnabled ? INTERFACE_LABELS[lang].sfxOn :
         INTERFACE_LABELS[lang].sfxOff, {
         fontSize: '11px', fontFamily: 'Arial', fontWeight: 'bold', fill: isSFXEnabled ? '#2ecc71' : '#e74c3c',
         backgroundColor: '#151d247e', padding: { x: 5, y: 4 }, border: '1px solid #34495e'
      }).setOrigin(0, 0).setInteractive({ useHandCursor: true }).setDepth(10).setScrollFactor(0);

      musicBtnRef = scene.add.text(260, 33, isMusicEnabled ? INTERFACE_LABELS[lang].musicOn :
         INTERFACE_LABELS[lang].musicOff, {
         fontSize: '11px', fontFamily: 'Arial', fontWeight: 'bold', fill: isMusicEnabled ? '#2ecc71' : '#e74c3c',
         backgroundColor: '#1818186b', padding: { x: 5, y: 4 }, border: '1px solid #34495e'
      }).setOrigin(0, 0).setInteractive({ useHandCursor: true }).setDepth(10).setScrollFactor(0);

   // Клик по кнопке музыки
   musicBtnRef.on('pointerdown', () => {
   let newState = !isMusicEnabled; toggleMusic(newState);
   updateButtonStyles();
   });

   // Клик по кнопке звуков
   sfxBtnRef.on('pointerdown', () => {
   let newState = !isSFXEnabled; toggleSFX(newState);
   updateButtonStyles();
   });

    // ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ ДЛЯ ОБНОВЛЕНИЯ ЦВЕТА И ТЕКСТА КНОПОК ЗВУКА
   function updateButtonStyles() {
   const currentLang = window.gameLanguage || 'ru';
   
   if (isMusicEnabled) {
   musicBtnRef.setText(INTERFACE_LABELS[currentLang].musicOn).setFill('#2ecc71');
   } else {
   musicBtnRef.setText(INTERFACE_LABELS[currentLang].musicOff).setFill('#e74c3c');
   }
   if (isSFXEnabled) {
   sfxBtnRef.setText(INTERFACE_LABELS[currentLang].sfxOn).setFill('#2ecc71');
   } else {
   sfxBtnRef.setText(INTERFACE_LABELS[currentLang].sfxOff).setFill('#e74c3c');
   }
   }

   // СОЗДАЕМ ГЛОБАЛЬНЫЙ ТРИГГЕР: Он принудительно вызывается из menu.js при клике на глобус!
   window.refreshGameInterfaceLang = () => {
   const newLang = window.gameLanguage || 'ru';
   
   // Мгновенно переводим табло счета (например, СЧЕТ: 0000 -> SCORE: 0000)
    if (scoreTextRef && currentScoreObject) {
    let points = currentScoreObject.value;
    let formattedPoints = String(points).padStart(4, '0');
     scoreTextRef.setText(PREFIXES[newLang] + formattedPoints);
    }
   // Мгновенно обновляем тексты кнопок музыки и звука на лету
   if (musicBtnRef && sfxBtnRef) {
   updateButtonStyles();
   }
   };
}

