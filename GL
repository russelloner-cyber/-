// Модуль генерации ретро-звуков (SFX) и фоновой синти-музыки
let audioCtx = null;
let musicInterval = null; 
export let isMusicEnabled = true;
export let isSFXEnabled = true;
export const gameFlags = { isGameActive: false }; // Флаг: игра сейчас активна или нет

function initAudio() {
    if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
    }
}

export function toggleMusic(state) {
    isMusicEnabled = state;
    if (!isMusicEnabled) {
        stopBackgroundMusic(); 
    } else {
        startBackgroundMusic(); 
    }
}

export function toggleSFX(state) {
    isSFXEnabled = state;
    if (!isSFXEnabled) {
        stopChaosSiren();
    }
}

function playTone(frequency, type, duration, volume, frequencyEnd = null) {
    initAudio();
    if (!audioCtx || audioCtx.state === 'suspended') return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(frequency, audioCtx.currentTime);
    if (frequencyEnd !== null) {
        osc.frequency.exponentialRampToValueAtTime(frequencyEnd, audioCtx.currentTime + duration);
    }
    gain.gain.setValueAtTime(volume, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
}

// СТАРУЯ ОРИГИНАЛЬНАЯ МУЗЫКА
export function startBackgroundMusic() {
  if (musicInterval) {
    clearInterval(musicInterval);
    musicInterval = null;
  }
  
  initAudio();
  if (!isMusicEnabled) return;
  
  const melodyString = "110,130,146,164";
  const melody = melodyString.split(',').map(Number);
  let step = 0;
  
  musicInterval = setInterval(() => {
    // ВСТАВЛЯЕМ ПРОВЕРКУ НА СИСТЕМНУЮ ПАУЗУ ЯНДЕКСА
    if (window.isMusicPausedBySystem) return; 
    
    if (!isMusicEnabled || !audioCtx) return;
    
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
      return;
    }
    
    playTone(melody[step], 'triangle', 0.25, 0.08);
    step = (step + 1) % melody.length;
  }, 400);
}

export function stopBackgroundMusic() {
    if (musicInterval) {
        clearInterval(musicInterval);
        musicInterval = null;
    }
}

// ЗВУК ШАГОВ (ТОТ САМЫЙ "ТУК-ТУК")
