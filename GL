const DB_DIR = process.env.AMVERA ? '/data' : path.join(process.cwd(), 'data');
const DB_PATH = path.join(DB_DIR, 'highscores.json');
const RATING_PATH = path.join(DB_DIR, 'rating.json');

function ensureDbDir() {
    if (!fs.existsSync(DB_DIR)) {
        try { fs.mkdirSync(DB_DIR, { recursive: true }); } catch (e) { console.error("Не удалось создать DB:", e); }
    }
}

function readScores() {
    ensureDbDir();
    try {
        if (!fs.existsSync(DB_PATH)) {
            fs.writeFileSync(DB_PATH, JSON.stringify([], null, 2));
        }
        return JSON.parse(fs.readFileSync(DB_PATH, 'utf8') || '[]');
    } catch { return []; }
}

function writeScores(scores) {
    ensureDbDir();
    fs.writeFileSync(DB_PATH, JSON.stringify(scores, null, 2), 'utf-8');
}

function readRating() {
    ensureDbDir();
    try {
        const rp = path.join(DB_DIR, 'rating.json');
        if (!fs.existsSync(rp)) {
            fs.writeFileSync(rp, JSON.stringify({ likes: 0, dislikes: 0 }, null, 2));
        }
        return JSON.parse(fs.readFileSync(rp, 'utf8'));
    } catch { return { likes: 0, dislikes: 0 }; }
}

function writeRating(data) {
    ensureDbDir();
    const rp = path.join(DB_DIR, 'rating.json');
    fs.writeFileSync(rp, JSON.stringify(data, null, 2), 'utf-8');
}

export default defineConfig({
    plugins: [
        // Сжатие gzip и brotli для всех ассетов (экономия ~60% размера)
