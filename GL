// СИСТЕМА ИСПРАВЛЕННОЙ СИРЕНЫ ХАОСА
let chaosSirenOsc = null;
let chaosSirenGain = null;
let chaosSirenInterval = null;

export function playChaosSiren() {
    if (!isSFXEnabled) return;
    initAudio();
    if (!audioCtx || chaosSirenOsc) return; 

    chaosSirenOsc = audioCtx.createOscillator();
    chaosSirenGain = audioCtx.createGain();
    
    chaosSirenOsc.type = 'triangle'; 
    chaosSirenOsc.frequency.setValueAtTime(300, audioCtx.currentTime);
    chaosSirenGain.gain.setValueAtTime(0.02, audioCtx.currentTime); 
    
    chaosSirenOsc.connect(chaosSirenGain);
    chaosSirenGain.connect(audioCtx.destination);
    chaosSirenOsc.start();
    
    let highTone = false;
    chaosSirenInterval = setInterval(() => {
    if (window.isMusicPausedBySystem) return; 
    
    if (!chaosSirenOsc || !audioCtx) return;
    highTone = !highTone;
    chaosSirenOsc.frequency.setValueAtTime(highTone ? 420 : 280, audioCtx.currentTime);
  }, 350);
}

export function stopChaosSiren() {
    if (chaosSirenInterval) {
        clearInterval(chaosSirenInterval);
        chaosSirenInterval = null;
    }
    if (chaosSirenOsc) {
        try {
            chaosSirenOsc.stop();
        } catch(e){}
        chaosSirenOsc.disconnect();
        chaosSirenOsc = null;
    }
    if (chaosSirenGain) {
        chaosSirenGain.disconnect();
        chaosSirenGain = null;
    }
}
// Полное глушение звука и защита сирены от зависания
export function handleVisibilityChange(isHidden) {
  initAudio();
  if (!audioCtx) return;

  if (isHidden) {
    // 1. Если играет сирена Хаоса — жестко её выключаем перед паузой, чтобы не было писка
    if (chaosSirenOsc) {
      try {
        chaosSirenOsc.stop();
        chaosSirenOsc.disconnect();
      } catch (e) { console.log(e); }
      chaosSirenOsc = null;
    }
    if (chaosSirenInterval) {
      clearInterval(chaosSirenInterval);
      chaosSirenInterval = null;
    }

    // 2. Ставим весь контекст на паузу
    if (audioCtx.state === 'running' || audioCtx.state === 'interactive') {
      audioCtx.suspend();
    }
    window.isMusicPausedBySystem = true; 
  } else {
    // 3. Возвращаемся на вкладку — возобновляем всё
    window.isMusicPausedBySystem = false;
    
    if (audioCtx.state === 'suspended') {
      audioCtx.resume().then(() => {
        // 4. Перезапускаем фоновую музыку ТОЛЬКО если игра сейчас активна
        if (gameFlags.isGameActive && isMusicEnabled && typeof startBackgroundMusic === 'function') {
          startBackgroundMusic();
        }
        
        // 5. Если игрок вернулся, а режим Хаоса всё еще активен — перезапускаем сирену чисто с нуля
        if (gameFlags.isGameActive && window.isChaosModeActive && typeof playChaosSiren === 'function') {
           playChaosSiren();
        }
      }).catch(err => {
        console.warn('Не удалось возобновить AudioContext:', err);
      });
    }
  }
}

